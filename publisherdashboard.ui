      <property name="styleSheet">
       <string notr="true">/* استایل کلی پس‌زمینه نوار پایینی */
QFrame {
    background-color: #FFFFFF; /* رنگ پس‌زمینه سفید */
    border-top: 1px solid #E5E7EB; /* یک خط خاکستری بسیار ملایم در بالای نوار */
}

/* استایل دکمه‌ها در حالت عادی */
QPushButton {
    background-color: transparent; /* پس‌زمینه شفاف */
    border: none;
    color: #6B7280; /* رنگ متن خاکستری ملایم */
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
    border-radius: 8px; /* کمی گرد کردن گوشه‌ها */
}

/* استایل دکمه‌ها وقتی موس روی آن‌ها می‌رود */
QPushButton:hover {
    background-color: #F3F4F6; /* یک هاله خاکستری خیلی روشن */
    color: #10B981; /* تغییر رنگ متن به سبز زمردی جذاب */
}

/* استایل دکمه‌ای که کلیک شده و فعال است */
QPushButton:checked {
    color: #10B981; /* رنگ سبز زمردی برای دکمه فعال */
    border-bottom: 3px solid #10B981; /* یک خط ضخیم زیر تب فعال */
}</string>
