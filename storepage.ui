     <property name="styleSheet">
      <string notr="true">/* تنظیمات پایه و ضخامت اسکرول‌بار */
QScrollBar:vertical {
    border: none;
    background: #E0E0E0; /* رنگ پس‌زمینه مسیر اسکرول */
    width: 10px; /* ضخامت دلخواه شما - می‌توانید بیشتر هم بکنید */
    margin: 0px 0px 0px 0px;
}

/* تنظیمات خود نوار لغزنده (دستگیره) */
QScrollBar::handle:vertical {
    background: #909090; /* رنگ نوار لغزنده */
    min-height: 30px; /* حداقل ارتفاع نوار */
    border-radius: 8px; /* گرد کردن گوشه‌ها برای زیبایی */
}

/* تغییر رنگ نوار وقتی موس روی آن می‌رود */
QScrollBar::handle:vertical:hover {
    background: #606060;
}

/* حذف فلش‌های کوچک بالا و پایین اسکرول‌بار برای ظاهر مدرن‌تر */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; 
}</string>
