  <property name="styleSheet">
   <string notr="true">/* استایل کلی گروه باکس */
QGroupBox {
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #bdc3c7;
    border-radius: 8px;
    margin-top: 15px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center; /* عنوان را وسط‌چین می‌کند */
    padding: 0 10px;
    color: #2c3e50;

}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #3498db; /* وقتی کاربر روی فیلد کلیک می‌کند آبی می‌شود */
}

/* استایل دکمه‌های معمولی */
QPushButton {
    background-color: #ecf0f1;
    border: 1px solid #bdc3c7;
    border-radius: 5px;
    padding: 5px 15px;
    color: #2c3e50;
}
QPushButton:hover {
    background-color: #bdc3c7;
}

/* استایل دکمه اصلی (ثبت و انتشار) */
QPushButton#btnSubmitBook { /* فرض بر این است که نام این دکمه را btnSubmitBook گذاشته‌ای */
    background-color: #27ae60;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border-radius: 8px;
    padding: 10px;
}
QPushButton#btnSubmitBook:hover {
    background-color: #2ecc71;
}</string>
